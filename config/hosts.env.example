# Copy to config/hosts.env (gitignored) and fill in before running any script.
#
# SOURCE = the machine being retired as a web server (robco, today).
# TARGET = the machine taking over the websites.

# ---- source (robco) ---------------------------------------------------------
SOURCE_HOST=robco                     # ssh alias or tailnet name
SOURCE_SSH_PORT=2222                  # robco's sshd listens on 2222, not 22
SOURCE_TAILSCALE_IP=100.87.155.125

# ---- target (the new web server) -------------------------------------------
TARGET_HOST=                          # e.g. ncr, or a VPS hostname
TARGET_SSH_PORT=22
TARGET_SSH_USER=                      # user with docker group membership
TARGET_TAILSCALE_IP=                  # fill in after Tailscale is up on target
TARGET_ROOT=/srv/web                  # where stacks live on the target

# ---- Cloudflare -------------------------------------------------------------
# Token scopes: Account:Cloudflare Tunnel:Edit, Zone:DNS:Edit, Zone:Zone:Read
# Zone Resources: Include -> All zones.
CF_API_TOKEN=
CF_ACCOUNT_ID=03403c8d64890f093172d1cfb128af97

# The tunnel that currently serves the public sites from robco ("robco" tunnel).
# Cutover option A reuses this tunnel by moving its connector to the target.
CF_TUNNEL_ID=a1b9673e-38ca-4738-947c-ebf466fb4cec

# Token used by Traefik for Let's Encrypt DNS-01 (Zone:DNS:Edit + Zone:Zone:Read).
# May be the same token as CF_API_TOKEN.
CF_DNS_API_TOKEN=

# ---- misc -------------------------------------------------------------------
ACME_EMAIL=dentadesign@gmail.com
