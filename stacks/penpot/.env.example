# Real values are on robco at /etc/dokploy/compose/robco-design-llggv8/code/.env
# PENPOT_SECRET_KEY and POSTGRES_PASSWORD MUST match the originals or the
# restored database and existing user sessions will not open.
PENPOT_VERSION=2.17.0
PENPOT_PUBLIC_URI=https://design.bgunnarsson.dev
PENPOT_SECRET_KEY=
PENPOT_FLAGS=disable-registration disable-email-verification enable-prepl-server
POSTGRES_USER=penpot
POSTGRES_PASSWORD=
PENPOT_TELEMETRY_ENABLED=true
