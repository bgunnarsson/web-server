# Copy to config/hosts.env (gitignored) and fill in before running any script.
#
# SOURCE = the machine being retired as a web server (robco, today).
# TARGET = the machine taking over the websites. It must already be added as a
#          server in Dokploy (the panel runs on ncr), with the apps deployed to it.
#
# Every script runs ON robco and reaches the target over ssh.

# ---- source (robco) ---------------------------------------------------------
SOURCE_HOST=robco                     # ssh alias or tailnet name
SOURCE_SSH_PORT=2222                  # robco's sshd listens on 2222, not 22
SOURCE_TAILSCALE_IP=100.87.155.125

# ---- target (the new web server) -------------------------------------------
TARGET_HOST=                          # ssh alias or tailnet name
TARGET_SSH_PORT=22
TARGET_SSH_USER=                      # user with docker group membership and sudo
TARGET_TAILSCALE_IP=                  # `tailscale ip -4` on the target

# ---- Cloudflare -------------------------------------------------------------
# Token scopes: Account:Cloudflare Tunnel:Read, Zone:DNS:Edit, Zone:Zone:Read
# Zone Resources: Include -> All zones.
CF_API_TOKEN=
CF_ACCOUNT_ID=03403c8d64890f093172d1cfb128af97

# The tunnel that serves the public sites from robco ("robco" tunnel). The
# cutover moves its connector to the target; the tunnel itself does not change.
CF_TUNNEL_ID=a1b9673e-38ca-4738-947c-ebf466fb4cec

# The "dokploy" tunnel, whose connector runs on ncr. It carries stale rules
# pointing at http://robco:80; `50-cutover-dns.sh check` reports them.
CF_DOKPLOY_TUNNEL_ID=5912c888-4551-474f-9e86-48a22f0f9ece
